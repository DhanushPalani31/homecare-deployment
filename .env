# ---------------------------------------------------------------------------
# HomeCare API – environment variables
# Copy to .env (development) or inject via your secret manager (staging/production).
# The server refuses to start in staging/production with dev placeholder secrets,
# without TURN configured, or with EXPOSE_DEV_OTP=true.
# ---------------------------------------------------------------------------

NODE_ENV=development            # development | test | staging | production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/homecare_dev
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0                   # set to 1 behind a single reverse proxy / load balancer

# --- Auth (generate with: openssl rand -base64 48) ---
#JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=homecare-api
JWT_AUDIENCE=homecare-clients
REFRESH_TTL_DAYS=30             # absolute session lifetime
REFRESH_IDLE_DAYS=7             # session ends after this much inactivity
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- OTP ---
OTP_LOGIN_REQUIRED=false        # true = every login requires OTP; otherwise per-user opt-in
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
#OTP_HMAC_SECRET=                # openssl rand -base64 48
EXPOSE_DEV_OTP=false            # dev only: return the code in API responses

# --- WebRTC ---
STUN_URLS=stun:stun.l.google.com:19302
# Your coturn server(s). Use both UDP and TLS (TCP/443 or 5349) for restrictive networks.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_STATIC_AUTH_SECRET=        # must equal coturn static-auth-secret
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Consultation routing ---
CONSULT_RING_TIMEOUT_SECONDS=60 # per doctor before escalating
CONSULT_MAX_ESCALATIONS=3       # doctors tried before NO_ANSWER
CALL_RECONNECT_GRACE_SECONDS=45 # how long a dropped participant may rejoin

# --- Files ---
UPLOAD_DIR=./uploads            # replace with encrypted object storage in production
UPLOAD_MAX_MB=15

# --- Push (optional). Paste the Firebase service-account JSON as one line. ---
FIREBASE_SERVICE_ACCOUNT_JSON=

LOG_LEVEL=info
ENABLE_SWAGGER=false            # Swagger UI is always on outside staging/production
